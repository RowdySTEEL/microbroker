# Copy to .env locally; never commit credentials.
ALPACA_API_KEY=
ALPACA_API_SECRET=
# trading: standard/paper API keys with headers.
# broker: legacy Broker API keys with Basic Auth.
ALPACA_AUTH_MODE=trading
# production for standard/paper keys; sandbox for Broker sandbox keys.
ALPACA_DATA_ENV=production
ALPACA_DATA_FEED=iex
DATABASE_URL=postgresql://microbroker:YOUR_EXISTING_PASSWORD@127.0.0.1:5432/microbroker
# PostgreSQL alternative: postgresql://microbroker:LOCAL_PASSWORD@localhost:5432/microbroker
LOG_LEVEL=INFO
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=3

# Only needed for docker compose PostgreSQL. Fill this uncommented line:
POSTGRES_PASSWORD=
# For an existing R1 installation, retain its Docker project/volume:
# COMPOSE_PROJECT_NAME=microbroker-r1
